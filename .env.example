# Copier vers .env.local (local) — NE JAMAIS COMMITER .env.local.
# Sur Vercel : définir ces variables dans les réglages du projet.

# === Serveur ===
# Clé API OpenAI. Poser un plafond de dépense (5 $) côté OpenAI.
OPENAI_API_KEY=

# Branche de contenu de ce déploiement (ex. corpus/nis2). Utilisée uniquement au
# build par l'ignoreCommand de vercel.json : le projet Vercel ne builde que sa
# branche. Inutile en local.
# CORPUS_BRANCH=

# Modèle de génération (au token — gpt-4o-mini = le moins cher).
MODEL=gpt-4o-mini
# Modèle d'embeddings (indexation — text-embedding-3-small = le moins cher).
EMBEDDING_MODEL=text-embedding-3-small

# Paramètres de récupération / découpe (défauts dans src/lib/config.ts).
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=1024
# RAG_CHUNK_OVERLAP=200
# Reformulation des questions de suivi (tours d'historique repris, marge de
# longueur tolérée au-delà de la question d'origine).
# RAG_CONDENSE_HISTORY_TURNS=3
# RAG_CONDENSE_MAX_EXTRA_CHARS=400

# Garde-fous coût de /api/chat (endpoint public porteur de la clé API).
# Nombre de messages d'historique réinjectés (2 par tour), longueur max de la
# question entrante, longueur cumulée max de tous les messages reçus.
# RAG_MAX_HISTORY_MESSAGES=20
# RAG_MAX_QUESTION_CHARS=4000
# RAG_MAX_TOTAL_CHARS=20000

# === Affichage (spécifique à chaque corpus / projet Vercel) ===
NEXT_PUBLIC_CORPUS_NAME=Corpus de démonstration
NEXT_PUBLIC_CORPUS_CUTOFF=non précisée
NEXT_PUBLIC_CORPUS_SOURCE_LABEL=Documents sources publics
# JSON (["q1","q2"]) ou "q1 | q2 | q3".
NEXT_PUBLIC_STARTER_QUESTIONS=["Résume le document", "Quels sont les points clés ?"]
