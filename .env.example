# Copier vers .env.local (local) — NE JAMAIS COMMITER .env.local.
# Sur Vercel : définir ces variables dans les réglages du projet.

# === Serveur ===
# Clé API OpenAI. Poser un plafond de dépense (5 $) côté OpenAI.
OPENAI_API_KEY=

# Modèle de génération (au token — gpt-4o-mini = le moins cher).
MODEL=gpt-4o-mini
# Modèle d'embeddings (indexation — text-embedding-3-small = le moins cher).
EMBEDDING_MODEL=text-embedding-3-small

# Paramètres de récupération / découpe (défauts dans src/lib/config.ts).
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=1024
# RAG_CHUNK_OVERLAP=200

# === Affichage (spécifique à chaque corpus / projet Vercel) ===
NEXT_PUBLIC_CORPUS_NAME=Corpus de démonstration
NEXT_PUBLIC_CORPUS_CUTOFF=non précisée
NEXT_PUBLIC_CORPUS_SOURCE_LABEL=Documents sources publics
# JSON (["q1","q2"]) ou "q1 | q2 | q3".
NEXT_PUBLIC_STARTER_QUESTIONS=["Résume le document", "Quels sont les points clés ?"]
